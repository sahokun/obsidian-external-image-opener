{
  "name": "obsidian-external-image-opener",
  "version": "1.0.1",
  "author": "sahokun",
  "description": "Open images in external programs with keyboard shortcuts or button clicks",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "bump": "node scripts/version.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "image"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "builtin-modules": "^5.5.0",
    "esbuild": "^0.28.2",
    "obsidian": "latest",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2"
  }
}
